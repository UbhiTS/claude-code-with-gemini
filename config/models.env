# ============================================================================
# Claude Code + Gemini on Vertex AI — 3-Agent Hybrid Model Configuration
# ============================================================================
# Every coding task is orchestrated across 3 specialized agents routed through
# the local LiteLLM Vertex AI Gateway (http://127.0.0.1:4000):
#
#   1. PLANNER_MODEL     : Deep architectural analysis & step-by-step PLAN.md
#   2. IMPLEMENTER_MODEL : High-speed code authoring, edits, & pytest loops
#   3. REVIEWER_MODEL    : Staff-level diff audit, security check, & REVIEW.md
#
# Supported Vertex AI Model IDs (see src/catalog.py for full list & pricing):
#   - claude-opus-5-5        ($5.00 in / $25.00 out per 1M tokens)
#   - claude-opus-5          ($5.00 in / $25.00 out per 1M tokens)
#   - claude-sonnet-5        ($3.00 in / $15.00 out per 1M tokens)
#   - claude-opus-4-8        ($5.00 in / $25.00 out per 1M tokens)
#   - claude-sonnet-4-6      ($3.00 in / $15.00 out per 1M tokens)
#   - claude-haiku-4-5       ($1.00 in / $5.00 out per 1M tokens)
#   - gemini-3.8-flash       ($0.75 in / $3.75 out per 1M tokens)
#   - gemini-3.7-flash       ($0.75 in / $3.75 out per 1M tokens)
#   - gemini-3.5-flash       ($1.50 in / $9.00 out per 1M tokens)
#   - gemini-3.5-flash-lite  ($0.30 in / $2.50 out per 1M tokens)
#   - gemini-3.1-pro         ($2.00 in / $12.00 out per 1M tokens)
# ============================================================================

PLANNER_MODEL="claude-opus-5-5"
IMPLEMENTER_MODEL="gemini-3.8-flash"
REVIEWER_MODEL="claude-sonnet-5"

# Reasoning / Thinking Effort per Agent Role
# - Claude 5.x / 4.8 supports: low | medium | high | xhigh | max
# - Gemini 3.8 / 3.7 Flash & 3.1 Pro support: low | medium | high (rejects minimal)
PLANNER_EFFORT="high"
IMPLEMENTER_EFFORT="medium"
REVIEWER_EFFORT="medium"

# Local LiteLLM Vertex AI Proxy Endpoint
LITELLM_PROXY_URL="http://127.0.0.1:4000"
LITELLM_MASTER_KEY="sk-vertex-hybrid-demo"
